{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": "fash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "FASH needs camera access for AR try-on." }],
      ["expo-media-library", { "photosPermission": "FASH needs photo access to save your looks." }],
      [
        "@reactvision/react-viro",
        {
          "android": { "xRMode": "AR" },
          "ios": {
            "cameraUsagePermission": "FASH uses your camera for AR try-on.",
            "photosPermission": "FASH would like to read photos.",
            "savephotosPermission": "FASH would like to save photos to your library."
          }
        }
      ]
    ]
  }
}